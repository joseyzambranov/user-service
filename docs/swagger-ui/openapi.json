          "email": {
            "type": "string",
            "format": "email",
            "description": "User email address"
          },
          "firstName": {
            "type": "string",
            "description": "User first name"
          },
          "lastName": {
            "type": "string",
            "description": "User last name"
          },
          "fullName": {
            "type": "string",
            "description": "User full name (computed from firstName + lastName)"
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the user account is active"
