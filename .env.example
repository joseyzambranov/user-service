# Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# AWS Configuration
# ============================================

# AWS Region (default: us-west-2)
AWS_REGION=us-west-2

# AWS Account ID (12-digit number)
# Get it with: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=123456789012

# ============================================
# Application Configuration
# ============================================

# Environment (dev, staging, prod)
ENVIRONMENT=dev

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ============================================
# DynamoDB Configuration
# ============================================

# DynamoDB table name (auto-set by CDK, override for local testing)
TABLE_NAME=UserService-Users

# DynamoDB endpoint (for local testing with DynamoDB Local)
# DYNAMODB_ENDPOINT=http://localhost:8000

# ============================================
# API Gateway Configuration
# ============================================

# API Gateway stage name
API_STAGE=dev

# CORS allowed origins (comma-separated, use * for dev only)
CORS_ALLOWED_ORIGINS=*

# ============================================
# Lambda Configuration
# ============================================

# Lambda timeout in seconds (max: 900 for Lambda, 30 for API Gateway sync)
LAMBDA_TIMEOUT=30

# Lambda memory size in MB (128-10240)
LAMBDA_MEMORY_SIZE=512

# Enable AWS X-Ray tracing (true/false)
ENABLE_XRAY_TRACING=true

# ============================================
# Testing Configuration
# ============================================

# Jest test timeout in milliseconds
JEST_TIMEOUT=10000

# Run tests in parallel (true/false)
JEST_RUN_IN_BAND=false

# ============================================
# CDK Configuration
# ============================================

# CDK environment account (leave empty to use AWS_ACCOUNT_ID)
CDK_DEFAULT_ACCOUNT=

# CDK environment region (leave empty to use AWS_REGION)
CDK_DEFAULT_REGION=

# CDK context values (for advanced usage)
# CDK_CONTEXT_KEY=value

# ============================================
# SAM Local Testing
# ============================================

# Port for SAM local API (default: 3000)
SAM_LOCAL_PORT=3000

# SAM local Docker network (default: bridge)
SAM_LOCAL_DOCKER_NETWORK=bridge

# ============================================
# Security & Compliance
# ============================================

# Enable encryption at rest (true/false)
ENABLE_ENCRYPTION=true

# Enable point-in-time recovery for DynamoDB (true/false)
ENABLE_PITR=true

# Data retention period in days (for CloudWatch Logs)
LOG_RETENTION_DAYS=7

# ============================================
# Feature Flags
# ============================================

# Enable Swagger UI endpoint (true/false)
ENABLE_SWAGGER_UI=true

# Enable request validation at API Gateway (true/false)
ENABLE_REQUEST_VALIDATION=true

# Enable detailed CloudWatch metrics (true/false)
ENABLE_DETAILED_METRICS=true

# ============================================
# Development Tools
# ============================================

# Enable source maps for better error traces (true/false)
ENABLE_SOURCE_MAPS=true

# Enable hot-swapping for faster deployments (true/false, dev only)
ENABLE_CDK_HOTSWAP=true

# ============================================
# Notes
# ============================================

# 1. Never commit .env file to git (it's in .gitignore)
# 2. For production, use AWS Secrets Manager or Parameter Store
# 3. Lambda environment variables are set by CDK in the stack
# 4. Local .env is only for development and testing
